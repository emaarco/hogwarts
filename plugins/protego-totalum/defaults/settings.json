{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["~/.gradle", "~/.m2", "~/.npm"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "raw.githubusercontent.com"],
      "strictAllowlist": true
    }
  },
  "permissions": {
    "deny": ["WebFetch", "WebSearch"]
  }
}
